<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>romea_arm_description</name>
  <version>0.0.0</version>
  <description>Package containing URDF and configurations files of arms.</description>

  <maintainer email="jean.laneurit@inrae.fr">Jean Laneurit</maintainer>

  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>romea_common_description</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend>

  <exec_depend>romea_common_utils</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend condition="$ROS_DISTRO &lt; jazzy">gazebo_ros2_control</exec_depend>
  <exec_depend condition="$ROS_DISTRO &gt;= jazzy">ur_simulation_gz</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
